{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "95241484",
   "metadata": {},
   "source": [
    "# Solrのベクトル検索のシンプルなサンプル\n",
    "\n",
    "Solrをベクトルデータベースとして使用するサンプル。\n",
    "\n",
    "※Solrのバージョン：9.8.1\n",
    "\n",
    "Solr 9.0以降でベクトル検索機能が追加され、knn_vector型を使用してベクトル検索が可能になりました。"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c02f9804-6d28-4947-ab5c-9f7f910b4a08",
   "metadata": {},
   "source": [
    "## 必要パッケージのインポート"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "71ddf6cd-060a-472d-9a19-fec3d6c1e2e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pysolr\n",
    "import requests\n",
    "from sentence_transformers import SentenceTransformer\n",
    "import time\n",
    "import json"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8e788bfc-e9b6-40a5-9b34-2c7c8f2ea571",
   "metadata": {},
   "source": [
    "## 設定"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ebcc3a7f-4758-4124-aaee-2d695bb55884",
   "metadata": {},
   "outputs": [],
   "source": [
    "SOLR_URL = 'http://llm-rag-examples-solr:8983/solr'\n",
    "COLLECTION_NAME = 'vector_test01'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ea076f11-2cc4-4317-9539-424073501272",
   "metadata": {},
   "outputs": [],
   "source": [
    "MODEL_NAME = 'all-MiniLM-L6-v2'\n",
    "MODEL_DIM = 384"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8ff769c4",
   "metadata": {},
   "source": [
    "## 埋め込みモデル初期化"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "683a263e",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = SentenceTransformer(MODEL_NAME)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "10ce32d8-47f0-4281-8fc5-738a348df8e9",
   "metadata": {},
   "source": [
    "## Solrクライアント接続"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "86c2d964-e35d-4884-b3ff-e671cae1ee7d",
   "metadata": {},
   "outputs": [],
   "source": [
    "solr = pysolr.Solr(f'{SOLR_URL}/{COLLECTION_NAME}', always_commit=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5495ead2",
   "metadata": {},
   "source": [
    "## コレクションの有無チェック、なければエラーで終了"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c9c1139e",
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    response = requests.get(f'{SOLR_URL}/admin/collections?action=LIST&wt=json')\n",
    "    collections = response.json().get('collections', [])\n",
    "    \n",
    "    if COLLECTION_NAME not in collections:\n",
    "        raise Exception(f'Collection {COLLECTION_NAME} がありません。まず、登録処理を実行してください。（solr-vector-ex01-01-insert.ipynb）')\n",
    "    else:\n",
    "        print(f'Collection {COLLECTION_NAME} が存在します。')\n",
    "except Exception as e:\n",
    "    raise Exception(f'Error: {e}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0f951671-bb1f-4a9a-b813-43869b1b7b97",
   "metadata": {},
   "source": [
    "## ベクトル検索"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f52c18d6-5374-43f8-b758-66af96bd7d27",
   "metadata": {},
   "outputs": [],
   "source": [
    "QUERY_TEXT = '日本の都市'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fdb35c95-a681-4547-a594-33866ceea7e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "query_vector = model.encode(QUERY_TEXT)\n",
    "print(f\"Query: {QUERY_TEXT}\")\n",
    "print(f\"Query vector dimension: {len(query_vector)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "knn-search",
   "metadata": {},
   "source": [
    "### kNN検索の実行"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d5585a21-48f7-430e-83fa-a3804b5711a9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Solr kNN検索クエリ構築\n",
    "vector_str = ','.join(map(str, query_vector.tolist()))\n",
    "knn_query = f'{{!knn f=vector topK=3}}{vector_str}'\n",
    "\n",
    "print(f\"KNN Query: {knn_query[:100]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "54dbdc40-2101-4341-ba37-621d5c4a17f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 検索実行\n",
    "search_results = solr.search(\n",
    "    q=knn_query,\n",
    "    fl='id,text,score',\n",
    "    rows=3\n",
    ")\n",
    "\n",
    "print(f\"Found {search_results.hits} documents\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "61639abc-3518-4f40-9f09-4393e28d2571",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 結果詳細表示\n",
    "for i, doc in enumerate(search_results):\n",
    "    print(f\"Result {i+1}:\")\n",
    "    print(f\"  ID: {doc.get('id', 'N/A')}\")\n",
    "    print(f\"  Score: {doc.get('score', 'N/A')}\")\n",
    "    print(f\"  Text: {doc.get('text', 'N/A')}\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b8be07f1-2148-4839-bdc6-9fa3bb46467d",
   "metadata": {},
   "source": [
    "## 検索結果の簡潔表示"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "simple-results",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"クエリ: {QUERY_TEXT}\")\n",
    "print(\"=\" * 50)\n",
    "for i, doc in enumerate(search_results):\n",
    "    score = doc.get('score', 0)\n",
    "    text = doc.get('text', 'N/A')\n",
    "    print(f\"スコア: {score:.4f} テキスト: {text}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "alternative-search",
   "metadata": {},
   "source": [
    "## 別のクエリでの検索例"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "alternative-query",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 別のクエリで検索\n",
    "QUERY_TEXT2 = 'ペット'\n",
    "query_vector2 = model.encode(QUERY_TEXT2)\n",
    "vector_str2 = ','.join(map(str, query_vector2.tolist()))\n",
    "knn_query2 = f'{{!knn f=vector topK=3}}{vector_str2}'\n",
    "\n",
    "search_results2 = solr.search(\n",
    "    q=knn_query2,\n",
    "    fl='id,text,score',\n",
    "    rows=3\n",
    ")\n",
    "\n",
    "print(f\"クエリ: {QUERY_TEXT2}\")\n",
    "print(\"=\" * 50)\n",
    "for i, doc in enumerate(search_results2):\n",
    "    score = doc.get('score', 0)\n",
    "    text = doc.get('text', 'N/A')\n",
    "    print(f\"スコア: {score:.4f} テキスト: {text}\")"
   ]
  }
 ],
